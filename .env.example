# Copy this file to .env and edit it on the server. Never commit .env.
OPENAI_API_KEY=
# Fast, inexpensive default for a full game. Local code performs the second validation layer.
OPENAI_BOARD_MODEL=gpt-6-luna
OPENAI_BOARD_REASONING=medium
OPENAI_BOARD_MAX_OUTPUT_TOKENS=16000
AI_REQUEST_TIMEOUT_SECONDS=150
# Low-cost, low-latency model for automatic advisory answer checks.
OPENAI_JUDGE_MODEL=gpt-6-luna
OPENAI_JUDGE_REASONING=low
AI_GENERATION_ATTEMPTS=2
# Reuse an identical request for one hour instead of paying to generate it again.
AI_GAME_CACHE_TTL_SECONDS=3600
AI_GAME_CACHE_LIMIT=20
MAX_PLAYERS=8
CLUE_SECONDS=12
ANSWER_SECONDS=15
READING_SECONDS=5
# Daily Double defaults: 15 seconds to wager, then 5 seconds to respond.
DAILY_DOUBLE_WAGER_SECONDS=15
DAILY_DOUBLE_ANSWER_SECONDS=5

# Register /cast-receiver in the Google Cast Developer Console.
# Leave blank to use Chrome's Cast tab fallback.
CAST_APP_ID=

# Keep a disconnected host room alive for this many seconds (default: 3600)
HOST_GRACE_SECONDS=3600
